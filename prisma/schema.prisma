generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id           Int       @id @default(autoincrement())
  nome         String
  sigla        String    @unique
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  usuarios     Usuario[]

  @@map("setor")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senha        String
  funcao       FuncaoUsuario
  isAdmin      Boolean       @default(false)
  idSetor      Int
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  setor        Setor         @relation(fields: [idSetor], references: [id])

  @@index([idSetor])
  @@map("usuario")
}

enum FuncaoUsuario {
  SECRETARIO
  SERVIDOR
  FISCAL
}