generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id           Int       @id @default(autoincrement())
  nome         String
  sigla        String    @unique
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  usuarios     Usuario[]

  @@map("setor")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senha        String
  funcao       FuncaoUsuario
  isAdmin      Boolean       @default(false)
  idSetor      Int
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  setor        Setor         @relation(fields: [idSetor], references: [id])

  @@index([idSetor])
  @@map("usuario")
}

enum FuncaoUsuario {
  PREFEITO
  SECRETARIO
  SERVIDOR
  FISCAL
}

model Licitacao {
  id Int @id @default(autoincrement())
  numeroProcesso String
  dataAbertura DateTime
  dataFechamento DateTime
  modalidade String
  status Boolean
  valorTotal Float

  @@map("licitacao")
}

model ItemLicitado {
  id Int @id @default(autoincrement())
  descricao String
  marca String
  unidade String
  quantidade Int
  precoUnitario Float
  precoTotal Float
  idLicitacao Int

  @@index([idLicitacao])
  @@map("item_licitado")
}

model Solicitacao{
  id Int @id @default(autoincrement())
  idUsuario Int
  idItemLicitado Int
  dataSolicitacao DateTime @default(now())
  quantPedida Int
  descricao String

  @@index([idUsuario])
  @@index([idItemLicitado])
  @@map("solicitacao")

}
